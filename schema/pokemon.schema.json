{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://speed-tiers/schema/pokemon.json",
  "title": "Speed Tiers Dataset",
  "description": "The app-facing data contract. Purely factual: base stats, types, sprite, usage. No computed speed tiers - those live in src/lib/speed.ts.",
  "type": "object",
  "required": ["meta", "pokemon"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["format", "generatedAt", "level", "count", "source"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "count": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "pokemon": {
      "type": "array",
      "items": { "$ref": "#/definitions/pokemon" }
    }
  },
  "definitions": {
    "pokemon": {
      "type": "object",
      "required": ["id", "num", "name", "types", "baseStats", "sprite", "usage", "usageRank"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "PokeAPI slug, stable key (e.g. flutter-mane, charizard-mega-y).",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "num": { "type": "integer", "minimum": 1, "description": "National Dex number." },
        "name": { "type": "string", "minLength": 1, "description": "Display name." },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "baseStats": {
          "type": "object",
          "required": ["hp", "atk", "def", "spa", "spd", "spe"],
          "additionalProperties": false,
          "properties": {
            "hp": { "type": "integer", "minimum": 1 },
            "atk": { "type": "integer", "minimum": 1 },
            "def": { "type": "integer", "minimum": 1 },
            "spa": { "type": "integer", "minimum": 1 },
            "spd": { "type": "integer", "minimum": 1 },
            "spe": { "type": "integer", "minimum": 1 }
          }
        },
        "sprite": { "type": "string", "format": "uri", "description": "Official artwork URL." },
        "usage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weighted usage in the format (0..1)."
        },
        "usageRank": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based rank by usage in the format (1 = most used)."
        }
      }
    }
  }
}
